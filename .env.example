# GEORGE GUI @Search — optional environment variables
#
# George is zero-config: nothing below is required. Variables only activate
# optional external adapters; unset features degrade gracefully.
# Copy to .env (never commit .env) if you use an env-loading MCP setup.

# ── Image generation (optional) ────────────────────────────────────────────
# Any OpenAI-compatible image API exposing POST {url}/images/generations
# GEORGE_IMAGE_API_URL=https://api.example.com/v1
# GEORGE_IMAGE_API_KEY=
# GEORGE_IMAGE_MODEL=gpt-image-1

# A local ComfyUI instance
# GEORGE_COMFY_URL=http://127.0.0.1:8188
# GEORGE_COMFY_CHECKPOINT=sd_xl_base_1.0.safetensors

# ── Research & automation adapters (optional) ──────────────────────────────
# Scrapling extraction sidecar (see examples/integrations/scrapling_sidecar.py)
# GEORGE_SCRAPLING_URL=http://127.0.0.1:8877

# Agent-Reach service for extended research reach
# GEORGE_AGENT_REACH_URL=http://127.0.0.1:8899

# browser-use server for authorized browser workflows
# GEORGE_BROWSER_USE_URL=http://127.0.0.1:8890

# changedetection.io watch management (official REST API)
# GEORGE_CHANGEDETECTION_URL=http://127.0.0.1:5000
# GEORGE_CHANGEDETECTION_API_KEY=
