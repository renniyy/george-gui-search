{
  "name": "george-gui-search",
  "version": "1.0.1",
  "description": "GEORGE GUI @Search \u2014 the AI creative-engineering MCP server for Roblox. Generates production-grade GUIs, Luau, design systems, thumbnails and project scaffolds. Build beyond imagination.",
  "type": "module",
  "license": "MIT",
  "author": "renniy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/renniyy/george-gui-search.git"
  },
  "homepage": "https://github.com/renniyy/george-gui-search#readme",
  "bugs": {
    "url": "https://github.com/renniyy/george-gui-search/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "roblox",
    "luau",
    "gui",
    "ai",
    "claude",
    "studio",
    "design-system",
    "thumbnails",
    "rojo"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "george-gui-search": "dist/index.js"
  },
  "main": "dist/api.js",
  "types": "dist/api.d.ts",
  "files": [
    "dist/core",
    "dist/integrations",
    "dist/index.js",
    "dist/index.d.ts",
    "dist/api.js",
    "dist/api.d.ts",
    "dist/server.js",
    "dist/server.d.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build",
    "test": "node --test dist/test/*.test.js",
    "test:e2e": "node --test dist/test/server.e2e.test.js",
    "prepublishOnly": "npm run clean && npm run build && npm run test",
    "start": "node dist/index.js",
    "smoke": "node examples/client-example.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "exports": {
    ".": {
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    },
    "./package.json": "./package.json"
  }
}
